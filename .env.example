# `rbxjoiner setup` writes this file for you — you don't need to touch it.
DISCORD_TOKEN=your-bot-token-here
# channel(s) to scan for teleport messages, comma-separated
CHANNEL_IDS=
# channel the bot posts join logs to (blank = off)
LOG_CHANNEL_ID=
# seconds to stay in each server before hopping to the next highest value
STAY_SECONDS=30
PLACE_ID=142823291
# "experiences" (roblox://experiences/start?...) or "legacy" (roblox://placeId=...)
LINK_STYLE=experiences
# ignore the same job id if it shows up again within this many ms
DEDUPE_MS=60000
# when idle, wait this long for a better server before joining
COLLECT_SECONDS=3
# drop queued servers older than this
EXPIRE_SECONDS=300
# skip servers whose rubis Total Value is below this
MIN_VALUE=0
# join right away (skip the collect wait and the current stay timer) when a server
# is worth this or more. 0 = off
INSTANT_VALUE=30

# ---- crash recovery ----
# watch the Roblox process and reopen the same server if it dies
HEARTBEAT=on
# how often to check (seconds)
HEARTBEAT_SECONDS=1
# dead checks in a row before reopening (debounce against a blip)
HEARTBEAT_DEAD_STREAK=3
# after a (re)launch, give Roblox this long to open before the heartbeat trusts "dead"
RECOVER_GRACE_SECONDS=25
# process name to watch — change for Roblox VNG etc.
ROBLOX_PACKAGE=com.roblox.client

# ---- Delta key system (optional; off until one of these is set) ----
# Pick a source:
#  (a) Platoboost — RECOMMENDED for the auto-link flow. Your Delta service id + HWID.
#      The bot pulls the current (rotating) checkpoint link on its own, and when a NEW
#      link drops it pings you (see KEY_MENTION). You complete it, paste the key back
#      with `/key <key>` — no restart — and it writes it to KEY_FILE for Delta. If
#      Platoboost already has an active key, it just grabs it hands-free.
PLATOBOOST_SERVICE=
PLATOBOOST_IDENTIFIER=
#  (b) KEY_LINK — a STATIC checkpoint / getkey link, used when you have no Platoboost
#      ids or as a fallback if the live pull fails. Same /getkey + /key <key> flow.
KEY_LINK=
#  (c) KEY_URL — a link that returns a key (a getkey endpoint or your own bypass).
#      Raw body or JSON both work. This makes it fully hands-free.
KEY_URL=
# who to @ when a new link drops — your Discord user id (right-click you → Copy User ID).
# a role is "&ROLEID", or use "everyone"/"here". blank = no ping.
KEY_MENTION=
# Platoboost API base (change only if your provider moved it)
PLATOBOOST_API=https://api.platoboost.com
# file Delta reads the key from (blank = don't write a file). ~ expands to home.
KEY_FILE=
# how often to re-check, assumed lifetime if the source won't say, and how early to warn
KEY_REFRESH_SECONDS=1800
KEY_TTL_SECONDS=86400
KEY_WARN_SECONDS=3600
# only if KEY_URL returns JSON/odd formats: where the key (and optional expiry) live
KEY_JSON_PATH=
KEY_EXPIRY_JSON_PATH=
KEY_REGEX=
