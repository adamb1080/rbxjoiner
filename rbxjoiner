#!/data/data/com.termux/files/usr/bin/bash
# rbxjoiner — Roblox auto-joiner bot for Termux.
#
#   rbxjoiner          start the bot (runs setup first if nothing is saved yet)
#   rbxjoiner setup    enter / change bot token, scan channel(s), logs channel, stay time
#   rbxjoiner config   show what's saved
#   rbxjoiner update   pull the latest version from GitHub

DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ENV_FILE="$DIR/.env"
cd "$DIR" || exit 1

# exit code bot.js uses for "bad/missing token" so we stop instead of restart-looping
EXIT_BAD_CONFIG=78

get_val() { # get_val KEY [default]
  local v=""
  [ -f "$ENV_FILE" ] && v="$(grep -m1 "^$1=" "$ENV_FILE" | cut -d= -f2-)"
  echo "${v:-$2}"
}

is_id() { [[ "$1" =~ ^[0-9]{15,22}$ ]]; }

# Strips paste junk (escape codes, invisible chars, "Bot " prefix) and keeps
# only characters a Discord token can contain.
clean_token() {
  local t="$1"
  t="${t//$'\e[200~'/}"
  t="${t//$'\e[201~'/}"
  t="${t#Bot }"
  printf '%s' "$t" | LC_ALL=C tr -cd 'A-Za-z0-9._-'
}

# Real bot tokens are three base64url chunks joined by dots: xxxx.yyyy.zzzz
is_token() { [[ "$1" =~ ^[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{4,}\.[A-Za-z0-9_-]{20,}$ ]]; }

mask() { [ -n "$1" ] && echo "...${1: -4}" || echo "(not set)"; }

# Reads a secret one key at a time and prints * for each character, so you can
# see that typing/pasting is actually working. Result goes in $SECRET.
read_secret() {
  local char
  SECRET=""
  printf '\e[?2004l'   # turn off bracketed paste so pastes don't get wrapped in escape codes
  printf '%s' "$1"
  while IFS= read -rsn1 char; do
    if [ -z "$char" ]; then                              # Enter
      break
    elif [ "$char" = $'\x7f' ] || [ "$char" = $'\b' ]; then  # Backspace
      if [ -n "$SECRET" ]; then
        SECRET="${SECRET%?}"
        printf '\b \b'
      fi
    else
      SECRET+="$char"
      printf '*'
    fi
  done
  echo
}

setup() {
  local cur_token cur_scan cur_logs token scan logs ok id ids
  cur_token="$(get_val DISCORD_TOKEN)"
  cur_scan="$(get_val CHANNEL_IDS)"
  cur_logs="$(get_val LOG_CHANNEL_ID)"

  echo
  echo "===== rbxjoiner setup ====="
  [ -n "$cur_token" ] && echo "(press Enter to keep what's in [brackets])"
  echo

  # bot token (shows * while typing/pasting)
  while true; do
    if [ -n "$cur_token" ]; then
      read_secret "enter bot token id [$(mask "$cur_token")]: "
      token="${SECRET:-$cur_token}"
    else
      read_secret "enter bot token id: "
      token="$SECRET"
    fi
    token="$(clean_token "$token")"
    if is_token "$token"; then
      echo "  got it ($(mask "$token"), ${#token} chars)"
      break
    fi
    if [ -n "$cur_token" ] && [ "$token" = "$(clean_token "$cur_token")" ]; then
      echo "  the saved token is broken, paste it again"
      cur_token=""
    fi
    echo "  that's not a bot token. it has two dots in it, like MTI3NDk...abc.GxYz12.AbC..."
    echo "  get it from: Developer Portal > your app > Bot > Reset Token"
    echo "  (NOT the Application ID or Public Key)"
  done

  # channel(s) to scan
  while true; do
    read -rp "channel scan id${cur_scan:+ [$cur_scan]}: " scan
    scan="$(printf '%s' "${scan:-$cur_scan}" | tr -d '[:space:]')"
    ok=1
    IFS=',' read -ra ids <<< "$scan"
    [ ${#ids[@]} -eq 0 ] && ok=0
    for id in "${ids[@]}"; do is_id "$id" || ok=0; done
    [ $ok -eq 1 ] && break
    echo "  needs a channel id (numbers only). more than one? separate with commas"
  done

  # logs channel (optional)
  while true; do
    read -rp "logs id${cur_logs:+ [$cur_logs]} (Enter to skip): " logs
    logs="$(printf '%s' "${logs:-$cur_logs}" | tr -d '[:space:]')"
    { [ -z "$logs" ] || is_id "$logs"; } && break
    echo "  needs a channel id (numbers only), or leave it blank"
  done

  # how long to stay in each server before hopping to the next one in the waitlist
  local cur_stay stay
  cur_stay="$(get_val STAY_SECONDS 60)"
  while true; do
    read -rp "seconds to stay in each server before the next one [$cur_stay]: " stay
    stay="$(printf '%s' "${stay:-$cur_stay}" | tr -d '[:space:]')"
    [[ "$stay" =~ ^[0-9]+$ ]] && break
    echo "  numbers only"
  done

  # ---- Delta key helper (optional) ----
  # When on: the bot posts your key link when it's time (and @s you), you complete it
  # and run /key <key>, and it writes the key to the file Delta reads — no restart.
  local DEFAULT_KEY_FILE="/storage/emulated/0/Delta/Internals/Cache/license"
  local cur_keylink cur_keymention cur_keyfile keylink keymention keyfile wantkey ans
  cur_keylink="$(get_val KEY_LINK)"
  cur_keymention="$(get_val KEY_MENTION)"
  cur_keyfile="$(get_val KEY_FILE)"
  keylink="$cur_keylink"; keymention="$cur_keymention"; keyfile="$cur_keyfile"

  echo
  if [ -n "$cur_keylink$cur_keyfile" ]; then
    read -rp "set up the Delta key helper (/getkey, /key)? [Y/n]: " wantkey
    [[ "$wantkey" =~ ^[Nn] ]] && wantkey="" || wantkey="y"
  else
    read -rp "set up the Delta key helper (/getkey, /key)? [y/N]: " wantkey
    [[ "$wantkey" =~ ^[Yy] ]] && wantkey="y" || wantkey=""
  fi

  if [ -n "$wantkey" ]; then
    # the link you open to get a Delta key (your getkey page)
    read -rp "paste your Delta key link${cur_keylink:+ [saved]}: " ans
    keylink="${ans:-$cur_keylink}"

    # discord user id so it can @ you when it's time — optional
    echo "  (user id = Discord Settings > Advanced > Developer Mode on,"
    echo "   then tap your name > Copy User ID. press Enter to skip.)"
    read -rp "your Discord user id${cur_keymention:+ [$cur_keymention]}: " ans
    keymention="$(printf '%s' "${ans:-$cur_keymention}" | tr -d '[:space:]')"

    # file Delta reads the key from — default is Delta's own license file
    read -rp "file Delta reads the key from [${cur_keyfile:-$DEFAULT_KEY_FILE}]: " ans
    keyfile="${ans:-${cur_keyfile:-$DEFAULT_KEY_FILE}}"
  fi

  # keep advanced values if they were already set (otherwise use defaults)
  local extras="" kv key
  for kv in PLACE_ID=142823291 LINK_STYLE=experiences DEDUPE_MS=60000 \
            COLLECT_SECONDS=3 EXPIRE_SECONDS=300 MIN_VALUE=0; do
    key="${kv%%=*}"
    extras+="$key=$(get_val "$key" "${kv#*=}")"$'\n'
  done

  # preserve any advanced key settings set by hand, so setup never wipes them
  local adv="" ak av
  for ak in PLATOBOOST_SERVICE PLATOBOOST_IDENTIFIER PLATOBOOST_API KEY_URL \
            KEY_REFRESH_SECONDS KEY_TTL_SECONDS KEY_WARN_SECONDS \
            KEY_JSON_PATH KEY_EXPIRY_JSON_PATH KEY_REGEX; do
    av="$(get_val "$ak")"
    [ -n "$av" ] && adv+="$ak=$av"$'\n'
  done

  {
    printf 'DISCORD_TOKEN=%s\nCHANNEL_IDS=%s\nLOG_CHANNEL_ID=%s\nSTAY_SECONDS=%s\n' \
      "$token" "$scan" "$logs" "$stay"
    printf '%s' "$extras"
    [ -n "$keylink" ]    && printf 'KEY_LINK=%s\n' "$keylink"
    [ -n "$keymention" ] && printf 'KEY_MENTION=%s\n' "$keymention"
    [ -n "$keyfile" ]    && printf 'KEY_FILE=%s\n' "$keyfile"
    printf '%s' "$adv"
  } > "$ENV_FILE"
  chmod 600 "$ENV_FILE"

  echo
  echo "saved. it'll remember this every time you run rbxjoiner."
  [ -n "$keylink" ] && echo "key helper on — in Discord use /getkey to get your link, then /key <key> to set it."
  echo
}

show_config() {
  if [ ! -f "$ENV_FILE" ]; then
    echo "nothing saved yet, run: rbxjoiner setup"
    return
  fi
  echo "bot token : $(mask "$(get_val DISCORD_TOKEN)")"
  echo "scan id(s): $(get_val CHANNEL_IDS '(not set)')"
  echo "logs id   : $(get_val LOG_CHANNEL_ID '(off)')"
  echo "stay time : $(get_val STAY_SECONDS 60)s per server"
  echo "min value : $(get_val MIN_VALUE 0)"
  echo "place id  : $(get_val PLACE_ID 142823291)"
  echo "link style: $(get_val LINK_STYLE experiences)"
  if [ -n "$(get_val KEY_LINK)$(get_val PLATOBOOST_SERVICE)$(get_val KEY_URL)" ]; then
    echo "key helper: on"
    echo "  key file: $(get_val KEY_FILE '(not set)')"
    echo "  @ you   : $(get_val KEY_MENTION '(off)')"
  else
    echo "key helper: off"
  fi
}

run_bot() {
  if [ -z "$(get_val DISCORD_TOKEN)" ] || [ -z "$(get_val CHANNEL_IDS)" ]; then
    echo "[rbx] first time? let's set you up."
    setup
  fi

  [ -d node_modules ] || npm install --omit=dev || exit 1

  # stop Android from sleeping Termux while the screen is off
  command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock
  trap 'command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock; echo; echo "[rbx] stopped."; exit 0' INT TERM

  while true; do
    node bot.js
    code=$?
    if [ $code -eq $EXIT_BAD_CONFIG ]; then
      echo "[rbx] fix your settings with: rbxjoiner setup"
      command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock
      exit 1
    fi
    echo "[rbx] bot stopped (exit $code), restarting in 5s... (ctrl+c to quit)"
    sleep 5
  done
}

update() {
  git pull --ff-only && npm install --omit=dev && echo "[rbx] up to date."
}

usage() {
  sed -n '4,8p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  ""|start) run_bot ;;
  setup)    setup ;;
  config)   show_config ;;
  update)   update ;;
  help|-h|--help) usage ;;
  *) echo "unknown command: $1"; usage; exit 1 ;;
esac
